# Copy these variable names into the existing backend/.env and fill values locally.
# Never commit or share the real .env file.
MONGODB_URI=
MONGODB_DB_NAME=nyayalens
SESSION_TTL_MINUTES=60

# Generate a fresh value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=

# Must match the provider callback host. For LinkedIn, use a public HTTPS URL.
OAUTH_BASE_URL=http://127.0.0.1:8000
FRONTEND_URL=http://localhost:5173

# Keep anonymous PDF/TXT analysis local. Public deployments should set false.
NYAYALENS_ENABLE_DEMO_ANALYSIS=true

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Optional only for legacy accounts that still need email-code verification.
OTP_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=NyayaLens
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Google Cloud Translation Advanced v3. The backend uses ADC; do not put a key here.
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_TRANSLATE_MODEL=general/nmt
NYAYALENS_TRANSLATION_MAX_CHARS=100000
